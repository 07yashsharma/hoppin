# ==========================================
# ROUTEMATE AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Demo mode uses stateful in-memory relational store)
DATABASE_URL=postgresql://postgres:password@localhost:5432/routemate_db

# Supabase Auth Integration (Optional - Safe demo mode active by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Mapping & Route Calculation Provider (Google Maps Platform or Mapbox)
# If unconfigured, the system runs with realistic high-fidelity vector corridor routing
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Payment Gateway (Razorpay India Test Mode)
# Safe demo mode processes simulated transactions when unset
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder

# SMS & Emergency Notification Dispatch (Twilio / Fast2SMS)
SMS_API_KEY=your_sms_gateway_key
POLICE_DISPATCH_WEBHOOK_URL=https://api.emergency.gov.in/v1/sos_dispatch
